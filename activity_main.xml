<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cafe express"
        android:textSize="30dp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Prise de commande"
        android:textSize="15dp"
        android:gravity="center"
        android:layout_marginBottom="28dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:text="Cafe :"
            android:textStyle="bold"
            android:textSize="14dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="10 dh"
            android:textSize="15dp"/>

        <Button
            android:id="@+id/btnMcafe"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:text="-"/>

        <TextView
            android:id="@+id/txtCafe"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:gravity="center"/>

        <Button
            android:id="@+id/btnPcafe"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:text="+" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:text="The :"
            android:textStyle="bold"
            android:textSize="14dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="8 dh"
            android:textSize="15dp"/>

        <Button
            android:id="@+id/btnMthe"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:text="-" />

        <TextView
            android:id="@+id/txtthe"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="16dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnPthe"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:text="+" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:text="Croissant :"
            android:textStyle="bold"
            android:textSize="14dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="6 dh"
            android:textSize="15dp" />

        <Button
            android:id="@+id/btnMcroissant"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:text="-" />

        <TextView
            android:id="@+id/txtCroissant"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="16dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnPcroissant"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:text="+" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nom du client" />

    <EditText
        android:id="@+id/edtNom"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="ex:    sara"
        android:inputType="textPersonName" />

    <TextView
        android:id="@+id/txtTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total   :   0 DH"
        android:textSize="30dp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="100dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVider"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Vider"/>

        <Button
            android:id="@+id/btnCommander"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="2"
            android:text="Commander"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>
